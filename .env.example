# Odoo Database Connection
ODOO_DB_HOST=203.151.190.135
ODOO_DB_PORT=5432
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=your_password_here
ODOO_DB_NAME=odoo_cff_golive
PORT=3000
# token สำหรับหน้า config + insert API (สร้างด้วย: openssl rand -hex 16)
ADMIN_TOKEN=change_me

# ---- โหมดเกตเวย์ (ใช้เฉพาะตัวที่ deploy บน VPS ออฟฟิศ 192.168.101.121 ให้ระบบอื่นเรียก) ----
# PUBLIC_MODE=1 = ไม่เสิร์ฟหน้าเว็บใด ๆ, เปิดเฉพาะ tables/schema/query/insert และบังคับ token ทุก request
PUBLIC_MODE=0
# ที่อยู่ที่ให้ bind — โหมดเกตเวย์ default เป็น 127.0.0.1 (สมัยมี Caddy อยู่หน้าบ้าน)
# ตอนนี้รันบน LAN ไม่มี proxy แล้ว ตัวจริงจึงตั้ง 0.0.0.0 เพื่อรับจากเครื่องอื่นในวงใน
# อย่าตั้ง 0.0.0.0 บนเครื่องที่มี IP จริงบนอินเทอร์เน็ตถ้าไม่มี TLS หน้าบ้าน
BIND_HOST=
# token แจกรายระบบ — ค่าจริงอยู่ใน tokens.json แก้ผ่านหน้า /tokens ได้โดยไม่ต้อง restart
# ช่องนี้ใช้แค่ตอน seed ครั้งแรก: "ชื่อทีม:token,ชื่อทีม2:token2" (openssl rand -hex 24)
API_TOKENS=
# ต้องมี header X-Proxy-Secret ตรงกับค่านี้ — ใช้ตอนมี reverse proxy หน้าบ้านเท่านั้น
# เส้นทางปัจจุบันเป็น LAN ตรง ไม่มี proxy จึงเว้นว่าง (เว้นว่าง = ปิดการตรวจ)
PROXY_SECRET=
RATE_LIMIT_PER_MIN=60
QUERY_TIMEOUT_MS=20000
QUERY_MAX_ROWS=5000
