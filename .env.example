# Odoo Database Connection
ODOO_DB_HOST=203.151.190.135
ODOO_DB_PORT=5432
ODOO_DB_USER=odoo
ODOO_DB_PASSWORD=your_password_here
ODOO_DB_NAME=odoo_cff_golive
PORT=3000
# token สำหรับหน้า config + insert API (สร้างด้วย: openssl rand -hex 16)
ADMIN_TOKEN=change_me

# ---- โหมดเปิดสาธารณะ (ใช้เฉพาะตัวที่ deploy ให้ทีมภายนอกเรียกจากอินเทอร์เน็ต) ----
# PUBLIC_MODE=1 = ไม่เสิร์ฟหน้าเว็บใด ๆ, เปิดเฉพาะ tables/schema/query/insert และบังคับ token ทุก request
PUBLIC_MODE=0
# token แจกรายทีม: "ชื่อทีม:token,ชื่อทีม2:token2" (สร้างด้วย openssl rand -hex 24, ยาวอย่างน้อย 16 ตัว)
API_TOKENS=
# ต้องมี header X-Proxy-Secret ตรงกับค่านี้ (กันคนยิงตรงข้าม proxy flowtica.link/odoo-api)
PROXY_SECRET=
RATE_LIMIT_PER_MIN=60
QUERY_TIMEOUT_MS=20000
QUERY_MAX_ROWS=5000
